{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entwurf",
  "version": "0.1.0",
  "identifier": "io.github.diewehmut.entwurf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && node ../../scripts/release/generate-notices.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Entwurf",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:48123"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "../../../packages/contracts/schemas/*",
      "resources/pdfium/**/*",
      "../../../assets/fonts/OFL.txt",
      "../../../assets/fonts/Typst-NOTICE.txt",
      "resources/gpt-bridge/**/*",
      "resources/licenses/**/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
