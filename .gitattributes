# Contract byte hashes must survive Windows and WSL checkouts unchanged.
/packages/contracts/** text eol=lf
*.pdf binary
*.png binary
*.ico binary
*.ttf binary
*.dll binary

# Preserve upstream license texts verbatim, including their original whitespace.
/assets/fonts/OFL.txt -text -whitespace
/assets/fonts/DejaVu-LICENSE.txt -text -whitespace
/assets/fonts/Typst-NOTICE.txt -text -whitespace
/apps/desktop/public/fonts/OFL.txt -text -whitespace
/apps/desktop/public/fonts/DejaVu-LICENSE.txt -text -whitespace
/apps/desktop/src-tauri/resources/pdfium/LICENSE -text -whitespace
/apps/desktop/src-tauri/resources/pdfium/licenses/* -text -whitespace
/docs/licenses/upstream/** -text -whitespace
