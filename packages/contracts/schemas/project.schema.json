{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entwurf.local/schemas/project.schema.json",
  "title": "Entwurf Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "created_at",
    "updated_at",
    "style",
    "tasks",
    "audit",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "style": {
      "$ref": "style.schema.json"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audit"
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "x-rust-name": "Point",
      "x-rust-module": "model",
      "x-rust-derives": [
        "Copy",
        "PartialEq"
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "x-rust-name": "Rect",
      "x-rust-module": "model",
      "x-rust-derives": [
        "Copy",
        "PartialEq"
      ]
    },
    "textLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "x",
        "baseline",
        "font_size",
        "bold"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "baseline": {
          "type": "number"
        },
        "font_size": {
          "type": "number"
        },
        "bold": {
          "type": "boolean"
        }
      },
      "x-rust-name": "TextLine",
      "x-rust-module": "model"
    },
    "placedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "title",
        "body",
        "latex",
        "page",
        "rect",
        "title_lines",
        "body_lines",
        "latex_lines",
        "text_clipped"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "kind": {
          "enum": [
            "chapter",
            "section",
            "concept",
            "definition",
            "formula",
            "theorem",
            "example",
            "warning",
            "note"
          ],
          "x-rust-name": "NodeKind",
          "x-rust-module": "ir",
          "x-rust-derives": [
            "PartialEq",
            "Eq",
            "PartialOrd",
            "Ord"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "latex": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u16"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "title_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textLine"
          }
        },
        "body_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textLine"
          }
        },
        "latex_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textLine"
          }
        },
        "text_clipped": {
          "type": "boolean"
        },
        "measured_content_rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/rect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact bounds of shaped glyph ink and math rules in page points.",
          "x-rust-default": true,
          "x-rust-skip-none": true
        },
        "measured_font_pt": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Smallest actual glyph size, including math scripts.",
          "x-rust-default": true,
          "x-rust-skip-none": true
        }
      },
      "x-rust-name": "PlacedNode",
      "x-rust-module": "model"
    },
    "placedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_node",
        "to_node",
        "page",
        "points",
        "label"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "from_node": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "to_node": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u16"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-rust-name": "PlacedEdge",
      "x-rust-module": "model"
    },
    "placedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "page",
        "rect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "title": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u16"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        }
      },
      "x-rust-name": "PlacedGroup",
      "x-rust-module": "model"
    },
    "layoutPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "width_pt",
        "height_pt",
        "margin_pt",
        "groups",
        "nodes",
        "edges"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u16"
        },
        "width_pt": {
          "type": "number"
        },
        "height_pt": {
          "type": "number"
        },
        "margin_pt": {
          "type": "number"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placedGroup"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placedNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placedEdge"
          }
        }
      },
      "x-rust-name": "LayoutPage",
      "x-rust-module": "model"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_pt",
        "height_pt",
        "margin_pt",
        "pages",
        "diagnostics"
      ],
      "properties": {
        "width_pt": {
          "type": "number"
        },
        "height_pt": {
          "type": "number"
        },
        "margin_pt": {
          "type": "number"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutPage"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "x-rust-name": "LayoutDocument",
      "x-rust-module": "model"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "message",
        "node_id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-rust-type": "Id"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ],
          "x-rust-name": "Severity",
          "x-rust-module": "ir",
          "x-rust-derives": [
            "PartialEq",
            "Eq"
          ]
        },
        "message": {
          "type": "string"
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ],
          "x-rust-type": "Id"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-rust-name": "Finding",
      "x-rust-module": "ir"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checked_at",
        "findings",
        "metrics"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "x-rust-type": "f64"
          }
        }
      },
      "x-rust-name": "ValidationReport",
      "x-rust-module": "ir"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svg",
        "png",
        "pdf",
        "manifest",
        "ir"
      ],
      "properties": {
        "svg": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "png": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pdf": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "ir": {
          "type": "string"
        }
      },
      "x-rust-name": "ArtifactPaths",
      "x-rust-module": "project"
    },
    "taskVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "created_at",
        "reason",
        "ir",
        "layout",
        "validation",
        "artifacts",
        "source_prompt_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "enum": [
            "ingested",
            "gpt_imported",
            "user_edited",
            "correction_reverted",
            "manual_snapshot"
          ],
          "x-rust-name": "VersionReason",
          "x-rust-module": "project",
          "x-rust-derives": [
            "PartialEq",
            "Eq"
          ]
        },
        "ir": {
          "$ref": "knowledge-ir.schema.json"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/layout"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/validation"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_prompt_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/layoutOptions"
            },
            {
              "type": "null"
            }
          ],
          "x-rust-default": true,
          "x-rust-skip-none": true
        },
        "visual_repairs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/visualRepairRecord"
          },
          "x-rust-default": true,
          "x-rust-skip-none": true
        },
        "visual_repair_enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "x-rust-default": true,
          "x-rust-skip-none": true
        }
      },
      "x-rust-name": "TaskVersion",
      "x-rust-module": "project"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "title",
        "chapter",
        "state",
        "created_at",
        "updated_at",
        "versions",
        "current_version",
        "paused_from",
        "last_error"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "DRAFT",
            "INGESTING",
            "IR_READY",
            "PROMPT_READY",
            "SENDING",
            "WAITING",
            "IMPORTING",
            "COMPILING",
            "VERIFYING",
            "NEEDS_REVIEW",
            "APPROVED",
            "EXPORTED",
            "PAUSED",
            "FAILED",
            "CANCELLED"
          ],
          "x-rust-name": "TaskState",
          "x-rust-module": "ir",
          "x-rust-derives": [
            "PartialEq",
            "Eq"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskVersion"
          }
        },
        "current_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "paused_from": {
          "anyOf": [
            {
              "enum": [
                "DRAFT",
                "INGESTING",
                "IR_READY",
                "PROMPT_READY",
                "SENDING",
                "WAITING",
                "IMPORTING",
                "COMPILING",
                "VERIFYING",
                "NEEDS_REVIEW",
                "APPROVED",
                "EXPORTED",
                "PAUSED",
                "FAILED",
                "CANCELLED"
              ],
              "x-rust-name": "TaskState",
              "x-rust-module": "ir",
              "x-rust-derives": [
                "PartialEq",
                "Eq"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-rust-name": "Task",
      "x-rust-module": "project"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "at",
        "task_id",
        "kind",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "project_created",
            "source_imported",
            "state_changed",
            "version_created",
            "correction_added",
            "correction_reverted",
            "export_completed",
            "validation_failed",
            "automation_paused",
            "error"
          ],
          "x-rust-name": "AuditKind",
          "x-rust-module": "project",
          "x-rust-derives": [
            "PartialEq",
            "Eq"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "x-rust-name": "AuditEvent",
      "x-rust-module": "project"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automation_enabled",
        "tesseract_available",
        "ocr_languages",
        "locale"
      ],
      "properties": {
        "automation_enabled": {
          "type": "boolean"
        },
        "tesseract_available": {
          "type": "boolean"
        },
        "ocr_languages": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        }
      },
      "x-rust-name": "ProjectSettings",
      "x-rust-module": "project"
    },
    "layoutOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pages",
        "min_font_pt",
        "max_font_pt",
        "column_gap_pt",
        "node_gap_pt",
        "card_padding_pt",
        "preferred_columns",
        "obstacle_routing",
        "max_heading_font_pt"
      ],
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u16"
        },
        "min_font_pt": {
          "type": "number"
        },
        "max_font_pt": {
          "type": "number"
        },
        "column_gap_pt": {
          "type": "number"
        },
        "node_gap_pt": {
          "type": "number"
        },
        "card_padding_pt": {
          "type": "number"
        },
        "preferred_columns": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u32"
        },
        "obstacle_routing": {
          "type": "boolean"
        },
        "max_heading_font_pt": {
          "type": "number",
          "minimum": 8
        }
      },
      "x-rust-name": "LayoutOptions",
      "x-rust-module": "model",
      "x-rust-derives": [
        "PartialEq"
      ]
    },
    "visualRepairRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "ir_hash",
        "style_hash",
        "round",
        "before",
        "after",
        "passed",
        "reverted",
        "before_geometry_hash",
        "after_geometry_hash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "ir_hash": {
          "type": "string"
        },
        "style_hash": {
          "type": "string"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "x-rust-type": "u16",
          "maximum": 3
        },
        "before": {
          "$ref": "#/$defs/layoutOptions"
        },
        "after": {
          "$ref": "#/$defs/layoutOptions"
        },
        "passed": {
          "type": "boolean"
        },
        "reverted": {
          "type": "boolean"
        },
        "before_geometry_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_geometry_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-rust-name": "VisualRepairRecord",
      "x-rust-module": "model",
      "x-rust-derives": [
        "PartialEq"
      ]
    }
  },
  "x-rust-name": "Project",
  "x-rust-module": "project"
}
